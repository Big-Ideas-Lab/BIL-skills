  "color": {
    "blue": {"900": "#012169", "800": "#003A70", "700": "#00539B", "100": "#E8F1FA", "050": "#F4F8FC"},
    "neutral": {"white": "#FFFFFF", "ink-950": "#111318", "ink-700": "#3F4650", "ink-500": "#68717D", "gray-200": "#D9DEE5", "gray-100": "#EDF0F4", "gray-050": "#F7F8FA"}
