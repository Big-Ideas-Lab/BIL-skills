{
  "meta": {
    "name": "BIL Research Report Design Foundations",
    "version": "1.0.0",
    "derives_from": "skills/productivity/presentation-slides/design-system/tokens.json (BIG IDEAs Lab Design Foundations 0.2.0)",
    "scope": ["color", "typography", "radius", "report-layout"]
  },
  "color": {
    "blue": {
      "900": "#012169",
      "800": "#003A70",
      "700": "#00539B",
      "100": "#E8F1FA",
      "050": "#F4F8FC"
    },
    "neutral": {
      "white": "#FFFFFF",
      "ink-950": "#111318",
      "ink-700": "#3F4650",
      "ink-500": "#68717D",
      "gray-200": "#D9DEE5",
      "gray-100": "#EDF0F4",
      "gray-050": "#F7F8FA"
    }
  },
  "semantic": {
    "background": "#FFFFFF",
    "surface": "#F7F8FA",
    "surface-accent": "#F4F8FC",
    "text-primary": "#111318",
    "text-secondary": "#3F4650",
    "text-muted": "#68717D",
    "border": "#D9DEE5",
    "primary": "#012169",
    "primary-hover": "#003A70",
    "focus": "#00539B"
  },
  "font": {
    "display": ["Source Serif 4", "Georgia", "Times New Roman", "serif"],
    "sans": ["Inter", "Helvetica Neue", "Arial", "sans-serif"],
    "mono": ["IBM Plex Mono", "SFMono-Regular", "Consolas", "monospace"]
  },
  "radius": {
    "card": "16px",
    "pill": "999px"
  },
  "layout": {
    "shell": "single column, max 1080px, centred",
    "base_scale": [8, 16, 24, 32, 48, 72],
    "side_padding": {"desktop": 32, "mobile": 20},
    "hypothesis_grid": {"columns_at_900px_and_up": 2, "below": 1},
    "sticky_nav": true,
    "print_expands_details": true
  }
}
